{
  "globalHeaders": {
    "Content-Security-Policy": "frame-ancestors 'self'"
  },
  "routes": [
    {
      "route": "/projects/personal-portfolio-platform",
      "rewrite": "/projects/personal-portfolio-platform/index.html"
    },
    {
      "route": "/projects/personal-portfolio-platform/",
      "rewrite": "/projects/personal-portfolio-platform/index.html"
    },
    {
      "route": "/projects",
      "rewrite": "/index.html"
    },
    {
      "route": "/projects/",
      "rewrite": "/index.html"
    },
    {
      "route": "/contact",
      "rewrite": "/contact/index.html"
    },
    {
      "route": "/contact/",
      "rewrite": "/contact/index.html"
    },
    {
      "route": "/about",
      "rewrite": "/index.html"
    },
    {
      "route": "/about/",
      "rewrite": "/index.html"
    },
    {
      "route": "/skills",
      "rewrite": "/index.html"
    },
    {
      "route": "/skills/",
      "rewrite": "/index.html"
    },
    {
      "route": "/experience",
      "rewrite": "/index.html"
    },
    {
      "route": "/experience/",
      "rewrite": "/index.html"
    },
    {
      "route": "/admin",
      "rewrite": "/admin/index.html",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "route": "/admin/",
      "rewrite": "/admin/index.html",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}

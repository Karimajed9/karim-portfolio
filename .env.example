# Copy to .env and set your own values. Never commit .env.
#   copy .env.example .env

# --- Required (Docker Compose + Spring) ---
# Postgres password (Compose service + SPRING_DATASOURCE_PASSWORD)
DB_PASSWORD=change-me

# Basic auth password for user "admin" (BCrypt-encoded at API startup)
ADMIN_PASSWORD=change-me

# --- Optional host ports (container ports stay fixed) ---
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Azure (optional — leave unset for local; no paid resources needed) ---
# APP_STORAGE_MODE=auto
# APP_STORAGE_LOCAL_DIR=./data/uploads
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_CONTAINER=portfolio-uploads
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# (Optional) Azure Application Insights — leave unset locally. Portal steps: docs/application-insights.md
# On Render, set the same name as a secret env var after creating the Insights resource.

# --- Frontend (local Vite only — put in frontend/.env if you need an override) ---
# VITE_API_BASE_URL=http://localhost:8080
# Docker image build already sets VITE_API_BASE_URL="" (same-origin /api via nginx).
#
# GitHub Pages: set repo Actions Variable VITE_API_BASE_URL to your public API
# (e.g. https://karim-portfolio-api.onrender.com). Leave unset for static-only Pages.
#
# --- Free Render backend (set in Render dashboard, not in this file) ---
# ADMIN_PASSWORD=
# CORS_ALLOWED_ORIGINS=https://karimmajed.com,https://www.karimmajed.com,https://karimajed9.github.io,http://localhost:5173,http://localhost:3000
# Pages build: leave VITE_BASE_PATH unset for apex (/). Set /karim-portfolio/ only for github.io project path.
# DB_HOST= DB_PORT=5432 DB_NAME=portfolio
# SPRING_DATASOURCE_USERNAME= DB_PASSWORD=
# PORT=8080 APP_STORAGE_MODE=local

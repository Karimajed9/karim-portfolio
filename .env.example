# Copy to .env and set your own values. Never commit .env.
#   copy .env.example .env

# --- Required (Docker Compose + Spring) ---
# Postgres password (Compose service + SPRING_DATASOURCE_PASSWORD)
DB_PASSWORD=change-me

# Basic auth password for user "admin" (BCrypt-encoded at API startup)
ADMIN_PASSWORD=change-me

# --- Optional host ports (container ports stay fixed) ---
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Azure (optional — leave unset for local; no paid resources needed) ---
# APP_STORAGE_MODE=auto
# APP_STORAGE_LOCAL_DIR=./data/uploads
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_CONTAINER=portfolio-uploads
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Frontend (local Vite only — put in frontend/.env if you need an override) ---
# VITE_API_BASE_URL=http://localhost:8080
# Docker image build already sets VITE_API_BASE_URL="" (same-origin /api via nginx).
